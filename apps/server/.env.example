# App
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
# Comma-separated list of allowed browser origins (each must be a full URL with scheme, no trailing slash)
CORS_ORIGIN=http://localhost:3001

# Database
DATABASE_URL=postgresql://tailorweddings2:tailorweddings2@localhost:5433/tailorweddings2
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/tailorweddings2_test
DB_POOL_MAX=20

# Auth — Clerk
CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Email — Resend (optional)
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=your@email.com

# Background jobs — Redis (optional)
REDIS_URL=redis://localhost:6379

# File storage - S3-compatible (optional)
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT: URL clients use to reach storage. Optional - defaults to S3_ENDPOINT.
# Set to your LAN IP MinIO URL when testing file downloads from a physical device,
# e.g. http://192.168.1.10:9000
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tailorweddings2
S3_SECRET_ACCESS_KEY=tailorweddings2123
S3_BUCKET=file-uploads

# Rollbar (optional)
ROLLBAR_SERVER_TOKEN=

# Stripe — subscriptions & billing (optional; billing disabled when unset)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# Price id for the "pro" subscription tier (from the Stripe dashboard)
STRIPE_PRICE_PRO=price_xxxxx
